{
  "name": "@ficusin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint . --max-warnings=0 && npm run lint:modules && npm run lint:css",
    "lint:css": "node scripts/check-dead-css.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:modules": "node scripts/check-runtime-modules.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "9.39.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.4.0",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  }
}
