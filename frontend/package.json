{
  "name": "@ficusin/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && npm run lint:css",
    "lint:css": "node scripts/check-dead-css.mjs",
    "test:money": "node --experimental-strip-types --test tests/money.test.mjs",
    "test:phone": "node --experimental-strip-types --test tests/phone.test.mjs",
    "test:payment-result": "node --experimental-strip-types --test tests/payment-result.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  }
}
