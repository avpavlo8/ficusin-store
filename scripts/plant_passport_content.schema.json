{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed plant passport content",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "name", "taxon", "sourceUrls", "passport"],
    "properties": {
      "code": {"type": "integer", "minimum": 1},
      "name": {"type": "string", "minLength": 1},
      "taxon": {"type": "string", "minLength": 1},
      "sourceUrls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://[^\\s]+$"}},
      "passport": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "humidity": {"type": "string", "minLength": 25},
          "temperature": {"type": "string", "minLength": 25},
          "soil": {"type": "string", "minLength": 25},
          "repotting": {"type": "string", "minLength": 25},
          "fertilizer": {"type": "string", "minLength": 25},
          "growthRate": {"type": "string", "minLength": 25}
        }
      }
    }
  }
}
