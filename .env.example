# Local development. Production uses APP_ENV=production, HTTPS SITE_URL,
# AUTH_COOKIE_SECURE=true, verified database TLS and real SMS/Telegram keys.
APP_ENV=development
SITE_URL=http://127.0.0.1:8080

# Local PostgreSQL; replace the account/database to match your instance.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ficusin?sslmode=disable
# Timeweb production: sslmode=verify-full plus the provider's CA if required.
DATABASE_SSL_CA=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=owner@example.com

# Required for production startup. Development/staging disable Telegram sends.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# SMS.ru user-initiated call verification. Required for real authentication:
# with an empty key the development stub confirms on the first status poll.
SMSRU_API_KEY=

# CDEK API credentials from the integrator's account. Without them the
# pick-up option disappears from the checkout instead of failing there.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# Saby service credentials. The same names are used by GitHub Actions and by
# the Timeweb backend. Values are never returned to the browser.
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
SABY_POINT_ID=278
SABY_PRICE_LIST_ID=6
# Procurement integration credentials; also the editor's default seller account.
WB_API_TOKEN=
OZON_CLIENT_ID=
OZON_API_KEY=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_ADDRESS=
AVITO_MANAGER_NAME=
AVITO_CONTACT_PHONE=
AVITO_CATEGORY=
AVITO_GOODS_TYPE=

# Yandex Geosuggest key for delivery address autocomplete. Without it the
# address field stays a plain text input.
YANDEX_SUGGEST_API_KEY=

# Web push (VAPID). Generate a P-256 key pair, keep the private half secret.
# Empty keys simply turn order notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ficusin.ru

# Оплата. Пусто — картой на сайте платить нельзя, остаются самовывоз
# с оплатой при получении и счёт для оптовых клиентов.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Configure receipt tax/VAT codes for the actual merchant account.
YOOKASSA_TAX_SYSTEM=
YOOKASSA_VAT_CODE=

# Почта. Пусто — письма покупателям не отправляются, всё остальное работает.
# Ящик заводится у почтового провайдера домена, пароль — от этого ящика.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Фикусин

# Server-only token for company/sole-proprietor suggestions (optional).
DADATA_API_KEY=

# Optional server-side purchase attribution; browser analytics settings live in DB.
METRIKA_MP_TOKEN=

# Public product-photo storage. Private uploads must use a different bucket.
S3_BUCKET=
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional editor seller-account overrides (metadata and live publication).
# Empty values fall back to WB_API_TOKEN/OZON_*; staging uses them for reads only.
CATALOG_OZON_CLIENT_ID=
CATALOG_OZON_API_KEY=
CATALOG_WB_API_TOKEN=

# Product-card publication is opt-in. Local mock uses an in-memory HTTP transport.
# disabled | mock | live (live requires production and the explicit gate below)
CATALOG_PUBLICATION_MODE=disabled
CATALOG_PUBLICATION_LIVE_ENABLED=false

# Private uploads (avatars, chat attachments, returns, documents, review media).
# Must differ from the public S3_BUCKET. Empty keeps legacy reads/text working,
# but new private file uploads return a clear error rather than DB fallback.
PRIVATE_S3_BUCKET=
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_REGION=
PRIVATE_S3_ACCESS_KEY=
PRIVATE_S3_SECRET_KEY=

# Optional physical origin of same-origin static asset bytes, including a release prefix.
# Publish/verify with cmd/publish-static-assets --apply before enabling this.
STATIC_ASSETS_BASE_URL=

# Explicit private-file emulator for local development only. Never publish this directory.
# Requires APP_ENV=development and CATALOG_PUBLICATION_MODE=mock; staging/production reject it.
LOCAL_PRIVATE_FILES_DIR=

# Explicit isolated-staging file test provider. s3 is the strict production default.
# mock is permitted only with APP_ENV=staging and an isolated ficusin_staging database.
# It persists synthetic private files/public images in separate test tables, never external S3.
FILE_STORAGE_MODE=s3
