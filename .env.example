# Public application URL, without a trailing slash
SITE_URL=https://ficusin.ru

# Timeweb Cloud PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=owner@example.com

# Key used to decrypt integration credentials stored in PostgreSQL
INTEGRATION_SECRETS_PRIVATE_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 = no VAT; confirm this value with the accountant before production
YOOKASSA_VAT_CODE=1

# CDEK API v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_API_URL=https://api.cdek.ru/v2
# CDEK city code for the dispatch warehouse in Ryazan
CDEK_FROM_CITY_CODE=

# Saby Retail
SABY_ACCESS_TOKEN=
SABY_POINT_ID=
SABY_PRICE_LIST_ID=
SABY_WAREHOUSE_ID=
# Separate random secret for the protected synchronization endpoint
SABY_SYNC_SECRET=
