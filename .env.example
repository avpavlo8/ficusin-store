# Public application URL, without a trailing slash
SITE_URL=https://ficusin.ru

# Timeweb Cloud PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=owner@example.com

# Telegram bot token. Required: without it the app refuses to start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=-5430918511

# SMS.ru api_id used to deliver OTP login codes by calling the user (no
# alphanumeric sender name / per-operator registration needed). Empty in
# development: codes are only printed to the console.
SMSRU_API_KEY=

# CDEK API credentials from the integrator's account. Without them the
# pick-up option disappears from the checkout instead of failing there.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# Почта России, корпоративный API «Отправка». RUSSIAN_POST_USER_AUTH_KEY —
# ключ из кабинета, который API просит передавать после `Basic` в заголовке
# X-User-Authorization. Индекс — точка отправки по договору.
RUSSIAN_POST_ACCESS_TOKEN=
RUSSIAN_POST_USER_AUTH_KEY=
RUSSIAN_POST_FROM_INDEX=

# Яндекс Доставка по Рязани. Токен берётся в кабинете корпоративного клиента.
# API расчёта требует координаты обеих точек, поэтому отдельно нужен ключ
# Геокодера и точные координаты магазина в порядке longitude / latitude.
YANDEX_DELIVERY_TOKEN=
YANDEX_GEOCODER_API_KEY=
YANDEX_DELIVERY_SENDER_ADDRESS=Россия, Рязань, ул. Новосёлов, 40А
YANDEX_DELIVERY_SENDER_LONGITUDE=
YANDEX_DELIVERY_SENDER_LATITUDE=

# Saby service credentials. The same names are used by GitHub Actions and by
# the Timeweb backend. Values are never returned to the browser.
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
SABY_POINT_ID=278
SABY_PRICE_LIST_ID=6
# Payments are not wired up yet: they need 54-ФЗ receipts first.

# Yandex Geosuggest key for delivery address autocomplete. Without it the
# address field stays a plain text input.
YANDEX_SUGGEST_API_KEY=

# Web push (VAPID). Generate a P-256 key pair, keep the private half secret.
# Empty keys simply turn order notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ficusin.ru

# Оплата. Пусто — картой на сайте платить нельзя, остаются самовывоз
# с оплатой при получении и счёт для оптовых клиентов.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — чеки по 54-ФЗ печатает ЮKassa. Пусто, если чеки выбивает своя касса,
# иначе на одну продажу выйдет два чека.
YOOKASSA_SEND_RECEIPT=
YOOKASSA_TAX_SYSTEM=
YOOKASSA_VAT_CODE=
SITE_URL=https://ficusin.ru

# Почта. Пусто — письма покупателям не отправляются, всё остальное работает.
# Ящик заводится у почтового провайдера домена, пароль — от этого ящика.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Фикусин
