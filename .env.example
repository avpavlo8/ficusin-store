# Public application URL, without a trailing slash
SITE_URL=https://ficusin.ru

# Timeweb Cloud PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=30
ADMIN_EMAILS=owner@example.com

# Telegram bot token. Required: without it the app refuses to start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=-5430918511

# SMS.ru api_id used to deliver OTP login codes by calling the user (no
# alphanumeric sender name / per-operator registration needed). Empty in
# development: codes are only printed to the console.
SMSRU_API_KEY=

# CDEK API credentials from the integrator's account. Without them the
# pick-up option disappears from the checkout instead of failing there.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

# Saby service credentials remain in GitHub Actions repository secrets.
# Payments are not wired up yet: they need 54-ФЗ receipts first.

# Yandex Geosuggest key for delivery address autocomplete. Without it the
# address field stays a plain text input.
YANDEX_SUGGEST_API_KEY=

# Web push (VAPID). Generate a P-256 key pair, keep the private half secret.
# Empty keys simply turn order notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@ficusin.ru
