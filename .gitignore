# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem
/backend/api

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
__pycache__/
*.pyc
frontend/vite.config.js
frontend/vite.config.d.ts
/dist/
**/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# playwright
/e2e/test-results/
/e2e/playwright-report/
/e2e/package-lock.json
